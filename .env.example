# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=
# Optional: direct (non-pooled) connection used only by `pnpm deploy:build` for `payload migrate`.
# Neon/Vercel set it automatically; falls back to DATABASE_URL when empty.
DATABASE_URL_UNPOOLED=
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_ENV=development
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hola@coffeeprojects.es
CONTACT_NOTIFY_EMAIL=contact@coffeeprojects.es
# Cloudflare Turnstile dev/staging test keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_HASH_SALT=
# Meta Pixel / Conversions API. Without PIXEL_ID the Pixel never loads; without CAPI_TOKEN server events are a logged no-op.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=
META_TEST_EVENT_CODE=
GITHUB_TOKEN=
PREVIEW_SECRET=
